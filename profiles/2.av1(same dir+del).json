{
    "name": "av1 same dir delete",

    "ffmpeg_args": [
        "-vf",
        "scale=w='if(gt(ih,1080),trunc(iw*1080/ih/2)*2,iw)':h='if(gt(ih,1080),1080,ih)',setsar=1",
        "-pix_fmt",
        "yuv420p",
        "-c:v",
        "libsvtav1",
        "-preset",
        "4",
        "-crf",
        "50",
        "-g",
        "300",
        "-c:a",
        "copy",
        "-svtav1-params",
        "tune=0",
        "-map_metadata",
        "-1",
        "-color_range",
        "tv",
        "-color_primaries",
        "bt709",
        "-color_trc",
        "bt709",
        "-colorspace",
        "bt709",
        "-tag:v",
        "av01",
        "-brand",
        "isom"
    ],

    "output": {
        "directory": "",
        "filename": "{source}_av1",
        "extension": ".mp4"
    },

    "after_finish": {
        "delete_source": true
    }
}