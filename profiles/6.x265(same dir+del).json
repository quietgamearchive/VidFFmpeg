{
    "name": "x265 same dir delete",

    "ffmpeg_args": [
        "-vf",
        "scale=w='if(gt(ih,1080),trunc(iw*1080/ih/2)*2,iw)':h='if(gt(ih,1080),1080,ih)',setsar=1",
        "-pix_fmt",
        "yuv420p",
        "-c:v",
        "libx265",
        "-preset",
        "medium",
        "-crf",
        "30",
        "-c:a",
        "copy",
        "-map_metadata",
        "-1",
        "-color_range",
        "tv",
        "-color_primaries",
        "bt709",
        "-color_trc",
        "bt709",
        "-colorspace",
        "bt709",
        "-x265-params",
        "keyint=300:min-keyint=30:colorprim=bt709:transfer=bt709:colormatrix=bt709:range=limited",
        "-tag:v",
        "hvc1",
        "-brand",
        "mp42"
    ],

    "output": {
        "directory": "",
        "filename": "{source}_x265",
        "extension": ".mp4"
    },

    "after_finish": {
        "delete_source": true
    }
}